---
// El esqueleto de la página, uno para los dos idiomas (DEC-008).
import '../styles/global.css';

interface Props {
  lang: string;
  titulo: string;
  descripcion: string;
}

const { lang, titulo, descripcion } = Astro.props;
// Lo de `public/` no pasa por Vite: hay que ponerle `base` a mano (C5).
const raiz = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${raiz}/favicon.svg`} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
  </head>
  <body>
    <slot />
  </body>
</html>
