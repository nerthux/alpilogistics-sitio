---
// El esqueleto de la página, uno para los dos idiomas (DEC-008).
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';

interface Props {
  lang: string;
  titulo: string;
  descripcion: string;
}

const { lang, titulo, descripcion } = Astro.props;
// Lo de `public/` no pasa por Vite: hay que ponerle `base` a mano (C5).
const raiz = import.meta.env.BASE_URL.replace(/\/$/, '');
// Open Graph (PLAN_sitio A8): el idioma de esta página y el de la otra.
const locales: Record<string, string> = { es: 'es_MX', en: 'en_US' };
const otroLocale = lang === 'es' ? locales.en : locales.es;
// `hreflang`, `og:url` y `og:image` piden URL absolutas, y ésas salen de
// `site`, que la CI pone (DEC-031); en local no hay `site` y se omiten.
const absolutas = Astro.site
  ? {
      alternos: [
        { hreflang: 'es', href: getAbsoluteLocaleUrl('es') },
        { hreflang: 'en', href: getAbsoluteLocaleUrl('en') },
        { hreflang: 'x-default', href: getAbsoluteLocaleUrl('es') },
      ],
      url: getAbsoluteLocaleUrl(lang),
      // La genera `pages/og.png.ts`, de 1200×630.
      imagen: new URL(`${raiz}/og.png`, Astro.site).href,
    }
  : null;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${raiz}/favicon.svg`} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={titulo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content={locales[lang]} />
    <meta property="og:locale:alternate" content={otroLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      absolutas && (
        <>
          {absolutas.alternos.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
          ))}
          <meta property="og:url" content={absolutas.url} />
          <meta property="og:image" content={absolutas.imagen} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={titulo} />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
