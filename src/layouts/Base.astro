---
// El esqueleto de la página, uno para los dos idiomas (DEC-008).
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';

interface Props {
  lang: string;
  titulo: string;
  descripcion: string;
}

const { lang, titulo, descripcion } = Astro.props;
// Lo de `public/` no pasa por Vite: hay que ponerle `base` a mano (C5).
const raiz = import.meta.env.BASE_URL.replace(/\/$/, '');
// `hreflang` pide URL absolutas, y ésas salen de `site`, que la CI pone
// (DEC-031); en local no hay `site` y se omite.
const alternos = Astro.site
  ? [
      { hreflang: 'es', href: getAbsoluteLocaleUrl('es') },
      { hreflang: 'en', href: getAbsoluteLocaleUrl('en') },
      { hreflang: 'x-default', href: getAbsoluteLocaleUrl('es') },
    ]
  : [];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${raiz}/favicon.svg`} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {alternos.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
