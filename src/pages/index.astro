---
// La página en español, en `/` (DEC-008).
import Pagina from '../components/Pagina.astro';
import { es as t } from '../i18n/es';

// La portada da el teléfono de la Gerente de Ventas (DEC-047).
const gerente = t.contacto.equipo[0];
---

<Pagina t={t} telefono={{ texto: gerente.telefono, tel: gerente.tel }} />
