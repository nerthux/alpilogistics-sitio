---
// La página en español, en `/` (DEC-008).
import Pagina from '../components/Pagina.astro';
import { es as t } from '../i18n/es';

// La portada del WordPress en español da el teléfono de Tijuana.
const administracion = t.contacto.departamentos[1];
---

<Pagina t={t} telefono={{ texto: administracion.telefono, tel: administracion.tel }} />
