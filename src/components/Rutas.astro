---
// Las cuatro ciudades. El mapa SVG llega con el sprint `sitio-en` (A6).
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['rutas'];
}

const { t } = Astro.props;
---

<section id="rutas" class="seccion">
  <div class="contenedor">
    <h2>{t.titulo}</h2>
    <p class="intro">{t.intro}</p>

    <ol class="ciudades">
      {t.ciudades.map((c) => <li>{c}</li>)}
    </ol>
    <p class="todo">{t.todo}</p>
  </div>
</section>

<style>
  .ciudades {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  /* Son cuatro: una, dos o cuatro columnas, para que ninguna quede sola. */
  @media (min-width: 36rem) {
    .ciudades {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 60rem) {
    .ciudades {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ciudades li {
    font-family: var(--fuente-titulos);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--blanco);
    background: var(--gris);
    border-bottom: 0.375rem solid var(--rojo);
    border-radius: 0.25rem;
    padding: 1.5rem;
  }
  .todo {
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--rojo);
  }
</style>
