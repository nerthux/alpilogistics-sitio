---
// El equipo de ventas de la presentación, con enlaces que se tocan
// (DEC-047): `tel:`, WhatsApp y el correo de ventas. El formulario espera
// §3.B.
import EncabezadoSeccion, { type Etiqueta } from './EncabezadoSeccion.astro';
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['contacto'];
  etiqueta: Etiqueta;
}

const { t, etiqueta } = Astro.props;
---

<section id="contacto" class="seccion">
  <div class="contenedor">
    <EncabezadoSeccion etiqueta={etiqueta} titulo={t.titulo} />

    <div class="rejilla">
      {
        t.equipo.map((p) => (
          <article class="tarjeta">
            <h3>{p.puesto}</h3>
            <p class="nombre">{p.nombre}</p>
            <p>
              {t.llamar}: <a href={`tel:${p.tel}`}>{p.telefono}</a>
            </p>
            <p>
              <a href={p.whatsapp} rel="noopener">{t.whatsappTexto}</a>
            </p>
          </article>
        ))
      }
    </div>

    <p class="correo">
      {t.escribir} <a href={`mailto:${t.correo}`}>{t.correo}</a>
    </p>
  </div>
</section>

<style>
  h3 {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }
  .nombre {
    font-weight: 600;
  }
  .tarjeta p {
    margin: 0.25rem 0;
  }
  .correo {
    margin: var(--espacio-6) 0 0;
  }
  a {
    color: var(--rojo);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
