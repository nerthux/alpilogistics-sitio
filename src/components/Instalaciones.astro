---
// Las yardas y el almacén, con las fotos de la presentación (DEC-046). Se
// sirven a su tamaño real, sin `widths`: son pequeñas y no se amplían. El
// respaldo en JPG: en PNG pesaría más que el original.
//
// En mosaico (PLAN_diseno E6): las verticales ocupan dos filas y, para que
// cada grupo cuadre en dos y en cuatro columnas sin huecos, las primeras
// horizontales se ensanchan a dos columnas hasta que las celdas sumen un
// múltiplo de 4. La orientación sale de la foto misma, no de `es.ts`.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import EncabezadoSeccion, { type Etiqueta } from './EncabezadoSeccion.astro';
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['instalaciones'];
  etiqueta: Etiqueta;
}

const { t, etiqueta } = Astro.props;

const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/instalaciones/*.png',
  { eager: true },
);

function foto(archivo: string) {
  const f = archivos[`../assets/instalaciones/${archivo}.png`];
  if (!f) throw new Error(`Instalaciones: no hay foto «${archivo}»`);
  return f.default;
}

function mosaico(fotos: Textos['instalaciones']['grupos'][number]['fotos']) {
  const piezas = fotos.map((f) => {
    const imagen = foto(f.archivo);
    return { ...f, imagen, vertical: imagen.height > imagen.width, ancha: false };
  });
  let celdas = piezas.reduce((n, p) => n + (p.vertical ? 2 : 1), 0);
  for (const p of piezas) {
    if (celdas % 4 === 0) break;
    if (!p.vertical) {
      p.ancha = true;
      celdas += 1;
    }
  }
  if (celdas % 4 !== 0) {
    throw new Error(`Instalaciones: el mosaico no cuadra (${celdas} celdas)`);
  }
  return piezas;
}
---

<section id="instalaciones" class="seccion alterna antes-de-diagonal">
  <div class="contenedor">
    <EncabezadoSeccion etiqueta={etiqueta} titulo={t.titulo} />

    {
      t.grupos.map((g) => (
        <>
          <h3>{g.titulo}</h3>
          <div class="galeria">
            {mosaico(g.fotos).map((p) => (
              <figure class:list={{ vertical: p.vertical, ancha: p.ancha }}>
                <Picture
                  src={p.imagen}
                  alt={p.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
        </>
      ))
    }
  </div>
</section>

<style>
  h3 {
    margin: 2.5rem 0 var(--espacio-5);
  }
  :global(.encabezado-seccion) + h3 {
    margin-top: 0;
  }
  .galeria {
    display: grid;
    gap: var(--espacio-4);
  }
  figure {
    margin: 0;
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
  }
  /* En el teléfono, una columna y cada foto en su proporción. */
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 35.5rem) {
    .galeria {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 14rem;
      grid-auto-flow: dense;
    }
    .vertical {
      grid-row: span 2;
    }
    .ancha {
      grid-column: span 2;
    }
    figure :global(img) {
      height: 100%;
      object-fit: cover;
    }
  }

  /* En cuatro columnas el grupo mide dos filas: las verticales van
     primero, de arriba abajo, y las demás llenan lo que queda. */
  @media (min-width: 56rem) {
    .galeria {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 13rem;
    }
    .vertical {
      grid-row: 1 / span 2;
    }
  }
</style>
