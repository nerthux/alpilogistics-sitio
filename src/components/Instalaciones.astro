---
// Las yardas y el almacén, con las fotos de la presentación (DEC-046). Se
// sirven a su tamaño real, sin `widths`: son pequeñas y no se amplían. El
// respaldo en JPG: en PNG pesaría más que el original.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import EncabezadoSeccion, { type Etiqueta } from './EncabezadoSeccion.astro';
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['instalaciones'];
  etiqueta: Etiqueta;
}

const { t, etiqueta } = Astro.props;

const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/instalaciones/*.png',
  { eager: true },
);

function foto(archivo: string) {
  const f = archivos[`../assets/instalaciones/${archivo}.png`];
  if (!f) throw new Error(`Instalaciones: no hay foto «${archivo}»`);
  return f.default;
}
---

<section id="instalaciones" class="seccion alterna">
  <div class="contenedor">
    <EncabezadoSeccion etiqueta={etiqueta} titulo={t.titulo} />

    {
      t.grupos.map((g) => (
        <>
          <h3>{g.titulo}</h3>
          <div class="galeria">
            {g.fotos.map((f) => (
              <figure>
                <Picture
                  src={foto(f.archivo)}
                  alt={f.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
        </>
      ))
    }
  </div>
</section>

<style>
  h3 {
    margin: 2.5rem 0 var(--espacio-5);
  }
  :global(.encabezado-seccion) + h3 {
    margin-top: 0;
  }
  .galeria {
    display: grid;
    gap: var(--espacio-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  /* Recortadas a 4:3 para que las verticales no rompan la rejilla. */
  figure {
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
