---
// Misión, visión y las áreas de la empresa (PLAN_contenido D3).
import EncabezadoSeccion, { type Etiqueta } from './EncabezadoSeccion.astro';
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['nosotros'];
  etiqueta: Etiqueta;
}

const { t, etiqueta } = Astro.props;
---

<section id="nosotros" class="seccion alterna">
  <div class="contenedor">
    <EncabezadoSeccion etiqueta={etiqueta} titulo={t.titulo} />

    <div class="rejilla">
      <article class="tarjeta">
        <h3>{t.misionTitulo}</h3>
        <p>{t.mision}</p>
      </article>
      <article class="tarjeta">
        <h3>{t.visionTitulo}</h3>
        <p>{t.vision}</p>
      </article>
    </div>

    <h3 class="areas">{t.areasTitulo}</h3>
    <div class="rejilla">
      {
        t.areas.map((a) => (
          <article class="tarjeta">
            <h4>{a.titulo}</h4>
            <ul>{a.puntos.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .areas {
    margin: 2.5rem 0 var(--espacio-5);
  }
</style>
