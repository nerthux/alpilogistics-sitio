---
// Misión, visión y las áreas de la empresa (PLAN_contenido D3).
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['nosotros'];
}

const { t } = Astro.props;
---

<section id="nosotros" class="seccion alterna">
  <div class="contenedor">
    <h2>{t.titulo}</h2>

    <div class="rejilla">
      <article class="tarjeta">
        <h3>{t.misionTitulo}</h3>
        <p>{t.mision}</p>
      </article>
      <article class="tarjeta">
        <h3>{t.visionTitulo}</h3>
        <p>{t.vision}</p>
      </article>
    </div>

    <h3 class="areas">{t.areasTitulo}</h3>
    <div class="rejilla">
      {
        t.areas.map((a) => (
          <article class="tarjeta">
            <h4>{a.titulo}</h4>
            <ul>{a.puntos.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .areas {
    margin: 2.5rem 0 1.5rem;
  }
  h4 {
    font-family: var(--fuente-titulos);
    font-size: 1.125rem;
    margin: 0 0 0.75rem;
  }
</style>
