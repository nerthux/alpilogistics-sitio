---
// Los servicios en bento (DEC-055, PLAN_diseno E5): una sola rejilla con
// los tres grupos, los adicionales y una pieza de acento con el lema de la
// portada; un ícono por pieza (DEC-038), la del lema sin ícono.
import Icono from './Icono.astro';
import EncabezadoSeccion, { type Etiqueta } from './EncabezadoSeccion.astro';
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['servicios'];
  lema: string;
  etiqueta: Etiqueta;
}

const { t, lema, etiqueta } = Astro.props;
---

<section id="servicios" class="seccion">
  <div class="contenedor">
    <EncabezadoSeccion etiqueta={etiqueta} titulo={t.titulo} />

    <div class="bento">
      {
        t.grupos.map((g, i) => (
          <article class:list={['pieza', i === 0 ? 'grande' : 'mediana', `g${i + 1}`]}>
            <Icono nombre={g.icono} />
            <h3>{g.titulo}</h3>
            <ul>{g.puntos.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))
      }

      <h3 class="adicionales">{t.adicionalesTitulo}</h3>
      {
        t.adicionales.map((a, i) => (
          <article class:list={['pieza', 'chica', `a${i + 1}`]}>
            <Icono nombre={a.icono} />
            <h4>{a.titulo}</h4>
            <ul>{a.puntos.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))
      }

      <p class="pieza acento">{lema}</p>
    </div>
  </div>
</section>

<style>
  /* En el teléfono, una columna en el orden del DOM. En tableta y en
     escritorio, ninguna pieza queda sola en un renglón. */
  .bento {
    display: grid;
    gap: var(--espacio-5);
  }

  @media (min-width: 35.5rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      grid-template-areas:
        'g1 g1'
        'g2 g3'
        'ad ad'
        'a1 a2'
        'a3 a4'
        'a5 lema';
    }

    /* Las áreas sólo donde hay plantilla: sin ella, todas las piezas caen
       en la misma celda implícita. */
    .g1 { grid-area: g1; }
    .g2 { grid-area: g2; }
    .g3 { grid-area: g3; }
    .adicionales { grid-area: ad; }
    .a1 { grid-area: a1; }
    .a2 { grid-area: a2; }
    .a3 { grid-area: a3; }
    .a4 { grid-area: a4; }
    .a5 { grid-area: a5; }
    .acento { grid-area: lema; }
  }

  @media (min-width: 56rem) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        'g1 g1 g2 g2'
        'g1 g1 g3 g3'
        'ad ad ad ad'
        'a1 a2 a3 a4'
        'a5 a5 lema lema';
    }
  }

  .adicionales {
    margin: var(--espacio-6) 0 0;
  }

  .pieza {
    margin: 0;
    border-radius: var(--radio);
    padding: var(--espacio-5);
  }

  .pieza :global(.icono) {
    display: block;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--espacio-3);
    color: var(--rojo);
  }

  .pieza h3 {
    margin-top: 0;
  }

  .pieza ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .grande,
  .mediana {
    background: var(--blanco);
    box-shadow: var(--sombra);
  }

  .grande {
    padding: var(--espacio-6);
  }

  .grande :global(.icono) {
    width: 3.5rem;
    height: 3.5rem;
  }

  .grande h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .chica {
    background: var(--fondo-alterno);
  }

  /* La elevación es global (`global.css`), pero la sombra de aquí le gana
     a la de allá: va junto a ella (DEC-054). */
  @media (hover: hover) {
    .pieza:hover {
      box-shadow: var(--sombra-alta);
    }
  }

  /* El acento en rojo, que va sobre fondo claro (DEC-052): la banda marino
     de Nosotros queda justo arriba. */
  .acento {
    display: flex;
    align-items: center;
    background: var(--rojo);
    color: var(--blanco);
    font-family: var(--fuente-titulos);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
  }
</style>
