---
// Los servicios en tres tarjetas y los adicionales, cada tarjeta con su
// ícono (PLAN_contenido D3, DEC-038).
import Icono from './Icono.astro';
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['servicios'];
}

const { t } = Astro.props;
---

<section id="servicios" class="seccion">
  <div class="contenedor">
    <h2>{t.titulo}</h2>

    <div class="rejilla">
      {
        t.grupos.map((g) => (
          <article class="tarjeta">
            <Icono nombre={g.icono} />
            <h3>{g.titulo}</h3>
            <ul>{g.puntos.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))
      }
    </div>

    <h3 class="adicionales">{t.adicionalesTitulo}</h3>
    <div class="rejilla cinco">
      {
        t.adicionales.map((a) => (
          <article class="tarjeta">
            <Icono nombre={a.icono} />
            <h4>{a.titulo}</h4>
            <ul>{a.puntos.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .adicionales {
    margin: 2.5rem 0 1.5rem;
  }
  h4 {
    font-family: var(--fuente-titulos);
    font-size: 1.125rem;
    margin: 0 0 0.75rem;
  }

  /* Cinco tarjetas no llenan los renglones de la rejilla: la última se
     quedaba sola. Con dos columnas, la última ocupa el renglón; con tres,
     van tres y dos, las dos más anchas. */
  @media (min-width: 35.5rem) and (max-width: 55.99rem) {
    .cinco {
      grid-template-columns: repeat(2, 1fr);
    }
    .cinco > :last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 56rem) {
    .cinco {
      grid-template-columns: repeat(6, 1fr);
    }
    .cinco > * {
      grid-column: span 2;
    }
    .cinco > :nth-child(n + 4) {
      grid-column: span 3;
    }
  }
</style>
