---
// El banner de portada (DEC-056), el lema y quiénes somos.
import { Picture } from 'astro:assets';
import banner from '../assets/portada.png';
import EncabezadoSeccion, { type Etiqueta } from './EncabezadoSeccion.astro';
import type { Textos } from '../i18n/es';

interface Props {
  t: Textos['portada'];
  telefono: { texto: string; tel: string };
  etiqueta: Etiqueta;
}

const { t, telefono, etiqueta } = Astro.props;
---

<section id="inicio" class="portada">
  <div class="banner">
    <Picture
      src={banner}
      alt={t.fotoAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1983]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <a class="hablemos" href="#contacto" aria-label={t.contactanos}></a>
  </div>

  <div class="llamado">
    <div class="contenedor">
      <h1>{t.lema}</h1>
      <div class="acciones">
        <a class="boton" href="#contacto">{t.contactanos}</a>
        <span>{t.llamanos} <a href={`tel:${telefono.tel}`}>{telefono.texto}</a></span>
      </div>
    </div>
  </div>

  <div class="contenedor quienes">
    <EncabezadoSeccion etiqueta={etiqueta} titulo={t.quienesTitulo}>
      {t.quienes.map((p) => <p>{p}</p>)}
    </EncabezadoSeccion>
  </div>
</section>

<style>
  /* El banner trae su texto dentro: se muestra entero, sin recorte ni capa
     encima. */
  .banner {
    position: relative;
  }
  .banner :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* El botón «Hablemos» es parte de la imagen: este enlace va encima de él,
     en porcentajes de la imagen de 1983×793. */
  .hablemos {
    position: absolute;
    left: 5%;
    top: 82.7%;
    width: 11%;
    height: 7.3%;
    border-radius: 999px;
  }
  .llamado {
    background: var(--marino);
    color: var(--blanco);
    padding-block: var(--espacio-7);
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    max-width: 18ch;
    margin: 0 0 1.5rem;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  /* Sobre marino, nada de rojo (DEC-052): el celeste del botón del banner. */
  .llamado .boton {
    background: var(--celeste);
    color: var(--marino);
  }
  .llamado .boton:hover,
  .llamado .boton:focus-visible {
    background: var(--blanco);
  }
  .acciones span a {
    color: var(--celeste);
    font-weight: 600;
    white-space: nowrap;
  }

  .quienes {
    padding-block: var(--espacio-8);
  }
  .quienes :global(.encabezado-seccion) {
    margin-bottom: 0;
  }
</style>
